# ==============================================================================
# Raft Board — Environment Variables Template
# Otter Software Systems (OSS)
# ==============================================================================

# Supabase Public Configuration (Exposed to client bundle via NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Server-Only Secret (Required for admin/approval operations)
# NEVER add NEXT_PUBLIC_ prefix to this variable. It must NEVER reach the browser.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Server-only HMAC secret for hashing client IP addresses in login logs (HMAC-SHA256)
# NEVER add NEXT_PUBLIC_ prefix to this variable.
IP_HASH_SECRET="otter-secure-ip-hmac-secret-change-in-production"

# Team Join Secret (Validated exclusively on the server for /signup)
# NEVER add NEXT_PUBLIC_ prefix to this variable.
TEAM_JOIN_CODE="OTTER-RAFT-2026"

# Bootstrap Super Admin Emails (Comma-separated, case-insensitive, server-only)
# Users signing up with these emails are automatically approved as active super_admins ONLY AFTER their email address has been confirmed.
# Any email containing "railey" also automatically receives is_treasurer = true once confirmed.
BOOTSTRAP_ADMIN_EMAILS="christian@otter.systems,railey@otter.systems"

# Scheduled Weekly Close Secret (Server-only)
# Used to authenticate Vercel / external cron requests to /api/tasks/close-week via Bearer token
CRON_SECRET="otter-scheduled-cron-secret-change-in-production"

# Base App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application Settings & Defaults (Stored exclusively in database settings table)
# Note: meeting_weekday, meeting_time, and timezone are read dynamically from database, never from env vars.
